accounts = []

n = int(input("Enter number of accounts: "))

for i in range(n):
    print("\nEnter details of account", i + 1)

    acc_no = int(input("Enter account number: "))
    name = input("Enter account holder name: ")
    email = input("Enter email ID: ")
    address = input("Enter address: ")
    balance = int(input("Enter balance: "))

    account = [acc_no, name, email, address, balance]
    accounts.append(account)


def deposit():
    acc_no = int(input("Enter account number: "))

    for account in accounts:
        if account[0] == acc_no:
            print("Account found.")
            amount = int(input("Please enter deposit amount: "))

            if amount <= 0:
                print("Invalid amount")
            else:
                account[4] = account[4] + amount
                print("Current balance:", account[4])
            return

    print("Account not found")


def withdraw():
    acc_no = int(input("Enter account number: "))

    for account in accounts:
        if account[0] == acc_no:
            amount = int(input("Enter withdraw amount: "))

            if amount <= 0:
                print("Invalid amount")
            elif amount > account[4]:
                print("Insufficient balance")
            else:
                account[4] = account[4] - amount
                print("Current balance:", account[4])
            return

    print("Account not found")


def show_accounts():
    print("\nBANK ACCOUNT DETAILS")
    print("-" * 85)
    print(f"{'Acc No':<10}{'Name':<15}{'Email':<25}{'Address':<20}{'Balance':<10}")
    print("-" * 85)

    for account in accounts:
        print(f"{account[0]:<10}{account[1]:<15}{account[2]:<25}{account[3]:<20}{account[4]:<10}")

    print("-" * 85)


while True:
    print("\n1. Deposit")
    print("2. Withdraw")
    print("3. Show Accounts")
    print("4. Exit")

    choice = int(input("Enter your choice: "))

    if choice == 1:
        deposit()
    elif choice == 2:
        withdraw()
    elif choice == 3:
        show_accounts()
    elif choice == 4:
        print("Thank you")
        break
    else:
        print("Invalid choice")